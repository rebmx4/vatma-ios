    <array><string>_phonedisk._tcp</string></array>
    <key>NSCameraUsageDescription</key>
    <string>Камера считывает QR-код подключения с экрана вашего ПК.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Face ID подтверждает доступ к вашим файлам.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key><true/>
    </dict>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Доступ нужен, чтобы копировать выбранные фото и видео на твой ПК.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Доступ нужен, чтобы сохранять загруженные фото и видео.</string>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array><string>$(PRODUCT_BUNDLE_IDENTIFIER).scan</string></array>
    <key>UIBackgroundModes</key>
    <array><string>processing</string></array>
    <key>UIFileSharingEnabled</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
