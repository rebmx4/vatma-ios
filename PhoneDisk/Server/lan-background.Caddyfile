{
    admin off
    auto_https off
    persist_config off
    default_sni files.rynpro.ru
}

https://:18117 {
    log {
        output file C:/PhoneDisk/Server/logs/lan-background-requests.log {
            roll_size 1MiB
            roll_keep 1
        }
        format filter {
            wrap json
            fields {
                request delete
                resp_headers delete
                user_id delete
            }
        }
    }
    bind 192.168.1.20
    tls C:/Luffi/Server/ingress/tls/certificates/acme-v02.api.letsencrypt.org-directory/files.rynpro.ru/files.rynpro.ru.crt C:/Luffi/Server/ingress/tls/certificates/acme-v02.api.letsencrypt.org-directory/files.rynpro.ru/files.rynpro.ru.key
    route {
        log_append phonedisk_method {http.request.method}
        log_append phonedisk_path {http.request.uri.path}
        @transfers path /api/v2/file /api/v2/uploads /api/v2/uploads/* /api/v2/capabilities
        reverse_proxy @transfers 127.0.0.1:18115 {
            header_up X-PhoneDisk-Lan 1
        }
        respond 404
    }
}
